     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
     def backtrack(index: int, path: List[List[int]], visited: List[List[bool]]) -> int:
         if index == len(grid):
             return 1
         for i in range(len(grid[0])):
             if grid[index][i] == 1 and not visited[index][i]:
                 visited[index][i] = True
                 path.append([grid[index][i]])
                 result = backtrack(index + 1, path, visited)
                 path.pop()
                 visited[index][i] = False
                 return result
         return 0
     visited = [[False]*len(grid[0]) for _ in range(len(grid))]
     return backtrack(0, [], visited)
