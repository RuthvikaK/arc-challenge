     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
     # Define a helper function to perform DFS
     def dfs(x: int, y: int, index: int, visited: List[List[bool]]) -> List[int]:
     # Check if the current position is out of bounds or visited
     if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or visited[x][y]:
     # If the current position is not visited, perform DFS on it
     if not visited[x][y]:
     # Mark the current position as visited
     visited[x][y] = True
     # Recursively call dfs on the neighboring positions
     for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
     # Perform DFS on the neighboring positions
     for i in range(index, len(grid)):
     # If the neighboring position is out of bounds, skip it
     if i < 0 or i >= len(grid):
     # Perform DFS on the neighboring position
     dfs(x + dx, y + dy, i, visited)
     # If the neighboring position is not visited, perform DFS on it
     if not visited[x + dx][y + dy]:
     # Mark the neighboring position as visited
     visited[x + dx][y + dy] = True
     # Recursively call dfs on the neighboring position
     dfs(x + dx, y + dy, i, visited)
     # Return the result of the DFS
     return grid[x][y]
     # Return the result of the DFS
     return grid[x][y]
     # If the current position is the goal, return the result
     if index == len(grid):
     # Return the result
     return grid[x][y]
     # Perform DFS on the current position
     return dfs(x, y, index, visited)
     # Perform DFS on the current position
     return dfs(x, y, index, visited)
     # If the current position is not the goal, return None
     return None
     # Define a helper function to perform BFS
     def bfs(x: int, y: int, index: int, visited: List[List[bool]], queue: List[List[int]]) -> List[int]:
     # Mark the current position as visited
     visited[x][y] = True
     # Add the current position to the queue
     queue.append([x, y])
     # Perform BFS on the current position
     while queue:
     # Perform BFS on the current position
     for i in range(len(queue)):
     # Get the current position
     x, y = queue[i]
     # Get the current index
     index = queue.index([x, y])
     # If the current index is not the goal, return the result
     if index!= len(queue) - 1:
     # Return the result
     return grid[x][y]
     # If the current index is the goal, return the result
     if index == len(queue) - 1:
     # Return the result
     return grid[x][y]
     # Remove the current position from the queue
     queue.pop(i)
     # Perform BFS on the neighboring positions
     for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
     # Perform BFS on the neighboring positions
     for i in range(index + 1, len(queue)):
     # Get the neighboring position
     x, y = queue[i]
     # Get the neighboring index
     index = queue.index([x, y])
     # If the neighboring position is not visited, perform BFS on it
     if not visited[x + dx][y + dy]:
     # Mark the neighboring position as visited
     visited[x + dx][y + dy] = True
     # Recursively call bfs on the neighboring position
     bfs(x + dx, y + dy, index, visited, queue)
     # Return the result
     return grid[x][y]
     # If the current position is not visited, perform BFS on it
     if not visited[x][y]:
     # Mark the current position as visited
     visited[x][y] = True
     # Recursively call bfs on the current position
     bfs(x, y, index, visited, queue)
     # Define the main function
     return solve(grid)
