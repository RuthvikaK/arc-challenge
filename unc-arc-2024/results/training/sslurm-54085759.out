        Again return ONLY the python program. Do not add any explanation, comments, or text other than code.
     import typing
     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
         def is_valid_move(pos: List[int]) -> bool:
             return 0 <= pos[0] < len(grid) and 0 <= pos[1] < len(grid[0])

         def get_neighbors(pos: List[int]) -> List[List[int]]:
             neighbors = []
             for i in range(-1, 2):
                 for j in range(-1, 2):
                     if i == 0 and j == 0:
                         continue
                     neighbors.append([pos[0] + i, pos[1] + j])
             return neighbors

         def dfs(pos: List[int], path: List[int], visited: List[bool], output: List[List[int]]) -> bool:
             if is_valid_move(pos):
                 output[pos[0]][pos[1]] = 0
                 for neighbor in get_neighbors(pos):
                     if not visited[neighbor[0]][neighbor[1]]:
                         visited[neighbor[0]][neighbor[1]] = True
                         if dfs(neighbor, path + [neighbor], visited, output):
                             return True
             return False

         visited = [[False] * len(grid[0]) for _ in range(len(grid))]
         path = []
         dfs([0, 0], path, visited, output)
         return output

