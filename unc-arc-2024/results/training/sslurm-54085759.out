                    if grid[x + i][y + j] == 0:
                        return False
            return True

        def dfs(grid, x, y, visited, path):
            visited.add((x, y))
            path.append((x, y))
            if check_valid(grid, x, y, visited):
                return path
            for i in range(1, 4):
                for j in range(1, 4):
                    if (x + i, y + j) in visited:
                        continue
                    new_path = dfs(grid, x + i, y + j, visited, path)
                    if new_path:
                        return new_path
            return None

        visited = set()
        path = []
        return dfs(grid, 0, 0, visited, path)
