     import typing
     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
     def helper(grid, output, path, depth):
         if not grid:
             return output, path
         for i in range(len(grid)):
             for j in range(len(grid[i])):
                 if grid[i][j] == 0:
                     continue
                 new_grid = [row[:] for row in grid]
                 new_grid[i][j] = 0
                 new_path, new_output = helper(new_grid, output, path + [[grid[i][j]]], depth + 1)
                 if new_output is not None:
                     return new_output, new_path
         return None, None
     return helper(grid, [], [], 0)```
