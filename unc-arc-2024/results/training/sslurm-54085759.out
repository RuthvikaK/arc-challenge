             grid = dfs(grid, x-1, y, visited)
             grid = dfs(grid, x, y+1, visited)
             grid = dfs(grid, x, y-1, visited)
     return grid
     def is_valid_move(grid: typing.List[typing.List[int]], x: int, y: int) -> bool:
     return 0 <= x < len(grid) and 0 <= y < len(grid[0]) and grid[x][y] == 0
     def solve_recursive(grid: typing.List[typing.List[int]], visited: typing.List[bool]) -> typing.List[typing.List[int]]:
     if len(grid) == 1:
         return grid
     for x in range(len(grid)):
         if is_valid_move(grid, x, 0):
             grid[x][0] = 1
             visited.append(True)
             result = solve_recursive(grid, visited)
             if result:
                 return result
             grid[x][0] = 0
             visited.pop()
     return None
     def solve(grid: typing.List[typing.List[int]]) -> typing.List[typing.List[int]]:
     return solve_recursive(grid, [False])```
