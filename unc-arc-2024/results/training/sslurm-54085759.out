        import re

        def solve(grid):
            def is_valid(i, j):
                return 0 <= i < len(grid) and 0 <= j < len(grid[0]) and grid[i][j] == 0

            def dfs(i, j):
                if is_valid(i, j):
                    if grid[i][j] == 0:
                        return 1
                    else:
                        grid[i][j] = 0
                        return 1 + dfs(i+1, j) + dfs(i-1, j) + dfs(i, j+1) + dfs(i, j-1)
                else:
                    return 0

            def solve_recursive(grid, row, col):
                if row < 0 or row >= len(grid) or col < 0 or col >= len(grid[0]) or grid[row][col]!= 0:
                    return 0
                grid[row][col] = 1
                return 1 + solve_recursive(grid, row+1, col) + solve_recursive(grid, row-1, col) + solve_recursive(grid, row, col+1) + solve_recursive(grid, row, col-1)

            def solve_recursive_recursive(grid, row, col):
                if row < 0 or row >= len(grid) or col < 0 or col >= len(grid[0]) or grid[row][col]!= 0:
                    return 0
                grid[row][col] = 1
                if is_valid(row, col):
                    grid[row][col] = 0
                    return 1
                return 0 + solve_recursive_recursive(grid, row+1, col) + solve_recursive_recursive(grid, row-1, col) + solve_recursive_recursive(grid, row, col+1) + solve_recursive_recursive(grid, row, col-1)

            return solve_recursive_recursive(grid, 0, 0)

