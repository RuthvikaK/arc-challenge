     import typing

     def solve(grid: typing.List[typing.List[int]]) -> typing.List[typing.List[int]]:
        rows, cols = len(grid), len(grid[0])
        visited = [[False for _ in range(cols)] for _ in range(rows)]

        def dfs(i: int, j: int) -> typing.List[int]:
            if visited[i][j]:
                return []
            if i < 0 or i >= rows or j < 0 or j >= cols or grid[i][j] == 0:
                return []
            if visited[i][j]:
                return [grid[i][j]]

            visited[i][j] = True

            path = dfs(i - 1, j) + dfs(i + 1, j) + dfs(i, j - 1) + dfs(i, j + 1)
            return path

        for i in range(rows):
            for j in range(cols):
                if grid[i][j] == 1 and not visited[i][j]:
                    path = dfs(i, j)
                    return [grid[i][j] + row for row in path]

        return []

