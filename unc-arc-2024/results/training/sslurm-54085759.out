     import typing

     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
        def dfs(i, j):
            if 0 <= i < len(grid) and 0 <= j < len(grid[0]) and grid[i][j] == 0:
                grid[i][j] = 1
                return [grid[i][j]] + dfs(i+1, j) + dfs(i-1, j) + dfs(i, j+1) + dfs(i, j-1)
            return []

        return dfs(0, 0)
