        def print_grid(grid):
            for row in range(len(grid)):
                for col in range(len(grid[0])):
                    print(f"{grid[row][col]:<6}", end=' ')
                print()

        def print_grid_recursive(grid, row, col):
            if row < 0 or row >= len(grid) or col < 0 or col >= len(grid[0]) or grid[row][col]!= 0:
                return
            print_grid(grid)
            print_grid_recursive(grid, row+1, col)
            print_grid_recursive(grid, row-1, col)
            print_grid_recursive(grid, row, col+1)
            print_grid_recursive(grid, row, col-1)

        def print_grid_recursive2(grid, row, col):
            if row < 0 or row >= len(grid) or col < 0 or col >= len(grid[0]) or grid[row][col]!= 0:
                return
            print_grid(grid)
            print_grid_recursive2(grid, row+1, col)
            print_grid_recursive2(grid, row-1, col)
            print_grid_recursive2(grid, row, col+1)
            print_grid_recursive2(grid, row, col-1)

        def print_grid_recursive3(grid, row, col):
            if row < 0 or row >= len(grid) or col < 0 or col >= len(grid[0]) or grid[row][col]!= 0:
                return
            print_grid(grid)
            print_grid_recursive3(grid, row+1, col)
            print_grid_recursive3(grid, row-1, col)
            print_grid_recursive3(grid, row, col+1)
            print_grid_recursive3(grid, row, col-1)

        print_grid(grid)

        return grid

