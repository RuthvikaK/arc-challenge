     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
     def is_valid_move(grid, row, col):
         return 0 <= row < len(grid) and 0 <= col < len(grid[0]) and grid[row][col] == 0

     def get_neighbors(grid, row, col):
         neighbors = []
         for i in range(-1, 2):
             for j in range(-1, 2):
                 if is_valid_move(grid, row + i, col + j):
                     neighbors.append((row + i, col + j))
         return neighbors

     def solve_recursive(grid, row, col, path):
         if row == len(grid) - 1:
             return path
         for neighbor in get_neighbors(grid, row, col):
             if neighbor in path:
                 continue
             new_path = solve_recursive(grid, neighbor[0], neighbor[1], path + [neighbor])
             if new_path is not None:
                 return new_path
         return None

     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
         return solve_recursive(grid, 0, 0, [])

