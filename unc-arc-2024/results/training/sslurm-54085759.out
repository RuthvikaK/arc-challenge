     def dfs(grid: typing.List[List[int]], row: int, col: int, visited: typing.List[bool]) -> typing.List[List[int]]:
     visited[row][col] = True
     for r in range(row-1, row+2):
         for c in range(col-1, col+2):
             if (r, c)!= (row, col) and not visited[r][c]:
                 grid[r][c] = grid[row][col]
                 return dfs(grid, r, c, visited)
     return grid
     def solve_recursive(grid: typing.List[List[int]], row: int, col: int, visited: typing.List[bool]) -> typing.List[List[int]]:
     visited[row][col] = True
     if row == len(grid) or col == len(grid[0]):
         return grid
     for r in range(row-1, row+2):
         for c in range(col-1, col+2):
             if (r, c)!= (row, col) and not visited[r][c]:
                 grid[r][c] = grid[row][col]
                 new_grid = solve_recursive(grid, r, c, visited)
                 if new_grid is not None:
                     return new_grid
     return None
     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
     visited = [[False for _ in range(len(grid[0]))] for _ in range(len(grid))]
     return solve_recursive(grid, 0, 0, visited)
