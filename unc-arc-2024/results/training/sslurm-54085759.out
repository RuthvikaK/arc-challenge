     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
     def dfs(i: int, j: int) -> int:
     grid[i][j] = 0
     for x, y in [(i-1, j), (i+1, j), (i, j-1), (i, j+1)]:
     if 0 <= x < len(grid) and 0 <= y < len(grid[0]) and grid[x][y]!= 0:
     if grid[x][y] == 1:
     return 1
     dfs(i, j)
     return 0
     for x, y in [(i-1, j), (i+1, j), (i, j-1), (i, j+1)]:
     if 0 <= x < len(grid) and 0 <= y < len(grid[0]) and grid[x][y]!= 0:
     if grid[x][y] == 1:
     return 1
     grid[x][y] = 0
     dfs(i, j)
     return 0
