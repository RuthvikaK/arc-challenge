            path.append(row * 10 + col)
            if grid[row][col] == 0:
                return
            if row == len(grid) - 1:
                output.append(path[:])
                return
            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
                dfs(row + dr, col + dc, visited, path)
            return

        visited = set()
        path = []
        output = []
        dfs(0, 0, visited, path)

        return output

        def main():
            grid = [
