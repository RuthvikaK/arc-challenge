        def recursive_solve(grid: typing.List[List[int]], current: typing.List[int]) -> typing.List[List[int]]:
     stack = [(current, grid)]
     while stack:
         current, grid = stack.pop()
         output = solve(grid)
         for row in output:
             grid.append(row)
         grid = grid[1:]
     return grid

