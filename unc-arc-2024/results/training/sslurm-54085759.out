     import typing
     from typing import List, Dict, Any
     def solve(grid: List[List[int]]) -> List[List[int]]:
         """
         Solves the given grid puzzle and returns the solution as a nested list.
         """
         def is_valid(x: int, y: int) -> bool:
             return 0 <= x < len(grid) and 0 <= y < len(grid[0])
         def get_neighbors(x: int, y: int) -> List[List[int]]:
             neighbors = []
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy):
                         neighbors.append(grid[x][y])
             return neighbors
         def get_first_nonzero(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return x + dx
             return -1
         def get_last_nonzero(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return y + dy
             return -1
         def get_first_nonzero_value(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_last_nonzero_value(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_first_nonzero_value_from_top(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_last_nonzero_value_from_top(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_first_nonzero_value_from_left(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_last_nonzero_value_from_left(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_first_nonzero_value_from_right(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def get_last_nonzero_value_from_right(x: int, y: int) -> int:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x][y]!= 0:
                         return grid[x][y]
             return -1
         def is_valid_solution(x: int, y: int, grid: List[List[int]]) -> bool:
             for dx in [-1, 0, 1]:
                 for dy in [-1, 0, 1]:
                     if is_valid(x + dx, y + dy) and grid[x + dx][y + dy] == 0:
                         return False
             return True
         if not grid:
             return grid
         for x in range(len(grid)):
             for y in range(len(grid[0])):
                 if grid[x][y]!= 0:
                     neighbors = get_neighbors(x, y)
                     if len(neighbors) > 0:
                         for neighbor in neighbors:
                             if is_valid_solution(x, y, grid) and is_valid_solution(neighbor[0], neighbor[1], grid):
                                 grid[x][y] = neighbor[2]
                                 grid[neighbor[0]][neighbor[1]] = neighbor[2]
                                 if is_valid_solution(x, y, grid) and is_valid_solution(neighbor[0], neighbor[1], grid):
                                     grid[x][y] = 0
                                     grid[neighbor[0]][neighbor[1]] = 0
                                     break
                                 else:
                                     grid[x][y] = 0
                                     grid[neighbor[0]][neighbor[1]] = 0
         return grid
