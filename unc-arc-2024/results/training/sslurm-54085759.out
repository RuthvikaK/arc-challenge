     import typing
     from typing import Dict, List, Tuple, Union
     def solve(grid: List[List[int]]) -> List[List[int]]:
     def rec_solve(grid: List[List[int]], x: int, y: int, path: List[List[int]]) -> Union[List[List[int]], None]:
     if x < 0 or y < 0 or x >= len(grid) or y >= len(grid[0]):
         return None
     if grid[x][y] == 0:
         return None
     if path[y][x]!= 0:
         return path[y][x]
     path[y][x] = grid[x][y]
     return rec_solve(grid, x + 1, y, path) or rec_solve(grid, x - 1, y, path) or rec_solve(grid, x, y + 1, path) or rec_solve(grid, x, y - 1, path)
     return None
     def solve_recursive(grid: List[List[int]], path: List[List[int]], output: List[List[int]]) -> List[List[int]]:
     if not grid:
         return output
     if not grid[0]:
         return None
     if grid[0][0] == 0:
         return None
     if grid[0][0] == 4:
         return output
     for i in range(len(grid)):
         for j in range(len(grid[0])):
             if grid[i][j] == 4:
                 path.append([i, j])
                 output = solve_recursive(grid, path, output)
                 if output:
                     return output
                 path.pop()
                 return None
     return None
     def solve_with_slicing(grid: List[List[int]], output: List[List[int]]) -> List[List[int]]:
     if not grid:
         return output
     if not grid[0]:
         return None
     if grid[0][0] == 4:
         return output
     for i in range(len(grid)):
         for j in range(len(grid[0])):
             if grid[i][j] == 4:
                 output[i][j] = 4
                 return output
     for i in range(len(grid)):
         for j in range(len(grid[0]) - 1):
             if grid[i][j] == 4:
                 output[i][j] = 4
                 return output
     for i in range(len(grid) - 1):
         for j in range(len(grid[0])):
             if grid[i][j] == 4:
                 output[i][j] = 4
                 return output
     return output
     grid = [[0, 0, 8], [8, 0, 8], [8, 0, 8]]
     output = [[0, 0, 0, 0, 0, 0, 0, 0, 8], [0, 0, 0, 0, 0, 0, 8, 0, 8], [0, 0, 0, 0, 0, 0, 8, 0, 8], [0, 0, 8, 0, 0, 0, 0, 0, 8], [8, 0, 8, 0, 0, 0, 8, 0, 8], [8, 0, 8, 0, 0, 0, 8, 0, 8], [0, 0, 8, 0, 0, 0, 0, 0, 8], [8, 0, 8, 0, 0, 0, 8, 0, 8], [8, 0, 8, 0, 0, 0, 8, 0, 8]]
     output = solve_with_slicing(grid, output)
     print(output)
