     def solve(grid: List[List[int]]) -> List[List[int]]:
        n = len(grid)
        def f(i, j):
            return grid[i][j]
        def g(i, j):
            return grid[i][j]
        def h(i, j):
            return grid[i][j]
        def dfs(i, j):
            if i<0 or i>=n or j<0 or j>=n or f(i, j)!= 0:
                return False
            if f(i, j) == 0:
                return True
            grid[i][j] = 0
            return dfs(i-1, j) or dfs(i+1, j) or dfs(i, j-1) or dfs(i, j+1)
        return [[dfs(i, j) for j in range(n)] for i in range(n)]
