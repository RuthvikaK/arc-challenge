     def solve(grid):
        def dfs(node, parent, visited, output):
            visited[node] = True
            output.append(node)
            for i in range(len(node)):
                if node[i] == 0 and visited[i] == False:
                    dfs(node[i], parent, visited, output)
            return output

        visited = [False] * len(grid[0])
        output = []
        dfs(grid, None, visited, output)
        return output

        import typing
        from typing import List
