"""
def solve(grid: List[List[int]]) -> List[List[int]]:
    memo = {}
    def dp(i, j):
        if (i, j) in memo:
            return memo[(i, j)]
        if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or grid[i][j] == 0:
            return grid[i][j]
        memo[(i, j)] = grid[i][j]
        if i == len(grid) - 1 and j == len(grid[0]) - 1:
            return grid[i][j]
        memo[(i, j)] = min(dp(i + 1, j), dp(i, j + 1))
        return memo[(i, j)]

    return dp(0, 0) if grid else []


