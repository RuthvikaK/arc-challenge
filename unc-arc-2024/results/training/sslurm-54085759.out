     def solve(grid: List[List[int]]) -> List[List[int]]:
        @lru_cache(None)
        def dp(i, j, memo):
            if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or memo[i][j]!= -1:
                return memo[i][j]
            if i == len(grid) - 1 and j == len(grid[0]) - 1:
                return [[grid[i][j] for j in range(len(grid[0]))] for i in range(len(grid))]
            memo[i][j] = -1
            result = []
            for x in range(len(grid[i])):
                for y in range(len(grid[i][0])):
                    if x == 0:
                        result.append(dp(i + 1, y, memo))
                    elif y == 0:
                        result.append(dp(i, j + 1, memo))
                    else:
                        result.append(dp(i, j + 1, memo))
                        result.append(dp(i + 1, y, memo))
            result = [x for x in result if x!= -1]
            memo[i][j] = -1
            return result

        return dp(0, 0, {}) if grid else []


"""
def solve(grid: List[List[int]]) -> List[List[int]]:
    @lru_cache(None)
    def dp(i, j, memo):
        if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or memo[i][j]!= -1:
            return memo[i][j]
        if i == len(grid) - 1 and j == len(grid[0]) - 1:
            return [[grid[i][j] for j in range(len(grid[0]))] for i in range(len(grid))]
        memo[i][j] = -1
        result = []
        for x in range(len(grid[i])):
            for y in range(len(grid[i][0])):
                if x == 0:
                    result.append(dp(i + 1, y, memo))
                elif y == 0:
                    result.append(dp(i, j + 1, memo))
                else:
                    result.append(dp(i, j + 1, memo))
                    result.append(dp(i + 1, y, memo))
        result = [x for x in result if x!= -1]
        memo[i][j] = -1
        return result

    return dp(0, 0, {}) if grid else []


