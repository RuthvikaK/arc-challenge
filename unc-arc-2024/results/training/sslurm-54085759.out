     import typing

     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
         def recursive_solve(grid: typing.List[List[int]], row: int, col: int) -> typing.List[List[int]]:
                 if row < len(grid) and col < len(grid[0]) and grid[row][col]!= 0:
                     return [grid[row][col]] + recursive_solve(grid, row + 1, col)
                 return []

         return recursive_solve(grid, 0, 0)

