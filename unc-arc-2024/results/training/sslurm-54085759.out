        Again return ONLY the python program. Do not add any explanation, comments, or text other than code.
     """
    def dfs(i: int, j: int, visited: set) -> typing.List[int]:
        if i < 0 or i >= len(grid) or j < 0 or j >= len(grid[0]) or (i, j) in visited:
            return []
        if grid[i][j] == 1:
            return [grid[i][j]]
        visited.add((i, j))
        result = []
        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            result.append(dfs(i + di, j + dj, visited))
        return result
    return dfs(0, 0, set())[::-1]  # Assuming 0-indexing
