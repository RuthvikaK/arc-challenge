     def is_valid_move(x: int, y: int, dx: int, dy: int) -> bool:
     """
     Checks if a move is valid.
     """
     if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or grid[x][y]!= 0:
         return False
     return True
     def is_valid_move2(x: int, y: int, dx: int, dy: int) -> bool:
     """
