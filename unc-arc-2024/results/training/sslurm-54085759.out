     def solve(grid: List[List[int]]) -> List[List[int]]:
        def dfs(node: tuple) -> List[int]:
            stack = [(node, [node])]
            visited = set()
            while stack:
                (x, y), path = stack.pop()
                if (x, y) not in visited:
                    visited.add((x, y))
                    path.append((x, y))
                    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                        nx, ny = x + dx, y + dy
                        if (0 <= nx < len(grid)) and (0 <= ny < len(grid[0])) and (grid[nx][ny] == 0) and ((x, y) not in path):
                            stack.append(((nx, ny), path.copy()))
        for node in grid:
            if node == 0:
                dfs(node)
        return grid
        """

        import json

        def dfs(node, path):
            stack = [(node, path)]
            visited = set()
            while stack:
                (x, y), path = stack.pop()
                if (x, y) not in visited:
                    visited.add((x, y))
                    path.append((x, y))
                    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                        nx, ny = x + dx, y + dy
                        if (0 <= nx < len(grid)) and (0 <= ny < len(grid[0])) and (grid[nx][ny] == 0) and ((x, y) not in path):
                            stack.append(((nx, ny), path.copy()))
            return path

        def find_closest(node, path):
            stack = [(node, path)]
            visited = set()
            while stack:
                (x, y), path = stack.pop()
                if (x, y) not in visited:
                    visited.add((x, y))
                    path.append((x, y))
                    if path[-1] == (0, 0):
                        return path
                    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                        nx, ny = x + dx, y + dy
                        if (0 <= nx < len(grid)) and (0 <= ny < len(grid[0])) and (grid[nx][ny] == 0) and ((nx, ny) not in path):
                            stack.append(((nx, ny), path.copy()))
            return None

        def find_path(grid, node):
            path = [node]
            while True:
                path = dfs(path[-1], path)
                if path[-1] == (0, 0):
                    return path
            return None

        return find_path(grid, (len(grid)-1, len(grid[0])-1))

