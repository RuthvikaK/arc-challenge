def solve(grid: List[List[int]]) -> List[List[int]]:
    def dfs(i: int, j: int) -> List[List[int]]:
        if 0 <= i < len(grid) and 0 <= j < len(grid[0]) and grid[i][j] == 0:
            grid[i][j] = 0
            return [[grid[x][y] for x in range(i, i + 2)] for y in range(j, j + 2)]
        return grid[i][j]
    stack = [[0, 0]]
    while stack:
        x, y = stack.pop()
        if dfs(x, y):
            return [[grid[i][j] for i in range(x, x + 2)] for j in range(y, y + 2)]
    return grid
```



