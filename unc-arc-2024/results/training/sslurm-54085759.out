     from typing import List
     def solve(grid: List[List[int]]) -> List[List[int]]:
     def is_valid(x, y, value):
     if x >= 0 and x < len(grid) and y >= 0 and y < len(grid[0]) and grid[x][y]!= value:
     return True
     else:
     return False

     def dfs(grid, row, col, visited, output):
     if is_valid(row, col, 0):
     return output
     visited[row][col] = True
     for x, y in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
     dfs(grid, row + x, col + y, visited, output)
     return output

     def backtrack(grid, output):
     if len(output) == len(grid) * len(grid[0]):
     return output
     visited = [[False for _ in range(len(grid[0]))] for _ in range(len(grid))]
     output.append(grid)
     for i in range(len(grid)):
     for j in range(len(grid[0])):
     if not is_valid(i, j, 0):
     return backtrack(grid, output)
     visited[i][j] = True
     output.append(grid)
     for x, y in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
     dfs(grid, i + x, j + y, visited, output)
