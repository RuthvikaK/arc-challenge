     def solve(self, grid: list) -> list:
        if len(grid) == 1:
            return [grid]
        last = grid[-1]
        if last[0] == 0:
            return self.solve(grid[:-1])
        for i in range(len(grid[-1])):
            for j in range(len(grid[-1][0])):
                if grid[-1][i][j] == 0:
                    grid[-1][i][j] = 1
                    grid = self.solve(grid[:-1])
                    if grid[-1] == [grid[-1][i][j] for i in range(len(grid[-1]))]:
                        return grid
                    grid[-1][i][j] = 0
        return grid

     def _find(self, grid: list) -> list:
        for i in range(len(grid)):
            for j in range(len(grid[i])):
                if grid[i][j] == 0:
                    return [i, j]

        return None

     def _is_valid(self, grid: list, i: int, j: int) -> bool:
        for k in range(len(grid)):
            if grid[k][i] == 0:
                return False
        return True

     def _is_valid_col(self, grid: list, j: int) -> bool:
        for i in range(len(grid)):
            if grid[i][j] == 0:
                return False
        return True

     def _is_valid_row(self, grid: list, i: int) -> bool:
        for k in range(len(grid[0])):
            if grid[i][k] == 0:
                return False
        return True

     def _is_valid_move(self, grid: list, i: int, j: int, k: int) -> bool:
        return self._is_valid(grid, i, j) and self._is_valid_col(grid, k) and self._is_valid_row(grid, i)

     def _swap(self, grid: list, i: int, j: int, k: int) -> list:
        grid[i][j], grid[k][j] = grid[k][j], grid[i][j]

     def _transpose(self, grid: list) -> list:
        return list(map(list, zip(*grid)))
