            directions = [[-1, 0], [0, -1], [1, 0], [0, 1], [-1, 1], [1, -1], [0, -1, 0], [0, 1, 0]]
            for r in range(rows):
                for c in range(cols):
                    if grid[r][c] == 1:
                        stack = [(r, c)]
                        while stack:
                            r, c = stack.pop()
                            for dr, dc in directions:
                                nr, nc = r + dr, c + dc
                                if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == 0:
                                    grid[nr][nc] = 1
                                    stack.append((nr, nc))
            return grid

        grid = json.loads(input())
        print(solve(grid))  # prints the solved grid
