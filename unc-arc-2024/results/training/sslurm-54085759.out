     def solve(grid: List[List[int]]) -> List[List[int]]:
        def dfs(grid, i, j, visited):
            if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or visited[i][j] or grid[i][j] == 0:
                return grid
            visited[i][j] = True
            grid[i][j] = 0
            dfs(grid, i+1, j, visited)
            dfs(grid, i-1, j, visited)
            dfs(grid, i, j+1, visited)
            dfs(grid, i, j-1, visited)
        def dfs_output(grid, i, j, visited):
            if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or visited[i][j] or grid[i][j]!= 0:
                return grid
            visited[i][j] = True
            grid[i][j] = 0
            dfs_output(grid, i+1, j, visited)
            dfs_output(grid, i-1, j, visited)
            dfs_output(grid, i, j+1, visited)
            dfs_output(grid, i, j-1, visited)
        def dfs3(grid, i, j, visited):
            if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or visited[i][j] or grid[i][j] == 0:
                return grid
            visited[i][j] = True
            grid[i][j] = 0
            dfs3(grid, i+1, j, visited)
            dfs3(grid, i-1, j, visited)
            dfs3(grid, i, j+1, visited)
            dfs3(grid, i, j-1, visited)
        def dfs2(grid, i, j, visited, path):
            if i < 0 or j < 0 or i >= len(grid) or j >= len(grid[0]) or visited[i][j] or grid[i][j] == 0:
                return grid
            visited[i][j] = True
            grid[i][j] = 0
            path.append((i, j))
            dfs2(grid, i+1, j, visited, path)
            dfs2(grid, i-1, j, visited, path)
            dfs2(grid, i, j+1, visited, path)
            dfs2(grid, i, j-1, visited, path)
        def solve_recursive(grid):
            visited = [[False for _ in range(len(grid[0]))] for _ in range(len(grid))]
            path = []
            grid[0][0] = 1
            dfs2(grid, 0, 0, visited, path)
            return path
        return solve_recursive(grid)
