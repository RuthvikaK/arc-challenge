         return [get_value_and_neighbors_and_neighbors(x, y, grid) for x, y in neighbors]

         def get_value_and_neighbors_and_neighbors_and_neighbors_and_neighbors(x: int, y: int, grid: List[List[int]]) -> List[Tuple[Tuple[Tuple[int, int], int], List[List[int]]]]:
         """
