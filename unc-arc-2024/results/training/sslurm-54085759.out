                path.append((i, j))
                return dfs2(grid, i+1, j, visited, path) + dfs2(grid, i-1, j, visited, path) + dfs2(grid, i, j+1, visited, path) + dfs2(grid, i, j-1, visited, path)
            return dfs3(grid, 0, 0, [False for _ in range(len(grid[0]))]) + dfs2(grid, 0, 0, [False for _ in range(len(grid[0]))], path) + dfs_output(grid, 0, 0, [False for _ in range(len(grid[0]))], path)
