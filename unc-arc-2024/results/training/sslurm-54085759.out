     from typing import List

     def solve(grid: List[List[int]]) -> List[List[int]]:
     def is_valid(x, y):
     return 0 <= x < len(grid) and 0 <= y < len(grid[0])

     def solve_recursive(grid, x, y, path, output):
     if is_valid(x, y) and grid[x][y] == 0:
     output.append(path)
     solve_recursive(grid, x+1, y, path+[grid[x][y]], output)
     solve_recursive(grid, x-1, y, path+[grid[x][y]], output)
     solve_recursive(grid, x, y+1, path+[grid[x][y]], output)
     solve_recursive(grid, x, y-1, path+[grid[x][y]], output)
     return output

     grid = [[0]*len(grid[0]) for _ in range(len(grid))]
     return solve_recursive(grid, 0, 0, [], grid)

     def is_valid(x, y):
     return 0 <= x < len(grid) and 0 <= y < len(grid[0])

     def solve_recursive(grid, x, y, path, output):
     if is_valid(x, y) and grid[x][y]!= 0:
     output.append(path)
     solve_recursive(grid, x+1, y, path+[grid[x][y]], output)
     solve_recursive(grid, x-1, y, path+[grid[x][y]], output)
     solve_recursive(grid, x, y+1, path+[grid[x][y]], output)
     solve_recursive(grid, x, y-1, path+[grid[x][y]], output)
     return output

     grid = [[0]*len(grid[0]) for _ in range(len(grid))]
     return solve_recursive(grid, 0, 0, [], grid)

