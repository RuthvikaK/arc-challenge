from collections import deque

def solve(grid: List[List[int]]) -> List[List[int]]:
    def dfs(node: Tuple[int, int], visited: Set[Tuple[int, int]], queue: deque[Tuple[int, int]]) -> List[List[int]]:
        if node in visited:
            return []
        visited.add(node)
        output = []
        for direction in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            next_node = (node[0] + direction[0], node[1] + direction[1])
            if 0 <= next_node[0] < len(grid) and 0 <= next_node[1] < len(grid[0]) and next_node not in visited:
                output.append(grid[next_node[0]][next_node[1]])
                output = dfs(next_node, visited, queue)
        return output

    return dfs((0, 0), set(), deque())

```


