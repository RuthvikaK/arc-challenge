     # Define a recursive helper function for DFS
     # This function is used to build the output grid
     def dfs(index: int, path: List[int], output: List[List[int]]) -> None:
     # Base case: If all input cells have been visited
     if index == len(grid):
     # Build the output grid with the current path
     output[path[0]:path[1]] = path
     return output
     # Recursive case: Explore the current cell and its neighbors
     for i in range(index, len(grid)):
     # Get the current cell's values
     cell = grid[path[index]][path[i]]
     # Check if the current cell is a valid input
