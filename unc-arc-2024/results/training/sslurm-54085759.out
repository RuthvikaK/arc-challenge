     import typing

     def solve(grid: typing.List[List[int]]) -> typing.List[List[int]]:
        return [
            [
                [grid[i][j] for j in range(len(grid[0]))],
                [grid[k][j] for k in range(len(grid))]
                if i < len(grid) and j < len(grid[0])
            ]
            for i in range(len(grid))
            for j in range(len(grid[0]))
        ]

