                if row == len(grid) - 1 and col == len(grid[0]) - 1:
                    return [row, col]
                if row < len(grid) - 1 and col == len(grid[0]):
                    return [row + 1, col]
                if row > 0 and col == len(grid[0]):
                    return [row, col + 1]
                if row < len(grid) - 1 and col < len(grid[0]):
                    return [row + 1, col + 1]
                if row > 0 and col > 0:
                    return [row, col + 1]
                if row > 0 and col < len(grid[0]):
                    return [row + 1, col]
                return []
            return [row[:] for row in grid]
            def recursive_slicing(grid: List[List[int]], row: int, col: int) -> typing.List[List[int]]:
                if row == len(grid) - 1 and col == len(grid[0]) - 1:
                    return grid
                if row < len(grid) - 1 and col == len(grid[0]):
                    return recursive_slicing(grid, row + 1, col)
                if row > 0 and col == len(grid[0]):
                    return recursive_slicing(grid, row, col + 1)
                if row < len(grid) - 1 and col < len(grid[0]):
                    return recursive_slicing(grid, row + 1, col + 1)
                if row > 0 and col > 0:
                    return recursive_slicing(grid, row + 1, col)
                if row > 0 and col < len(grid[0]):
                    return recursive_slicing(grid, row + 1, col + 1)
                return recursive_slicing(grid, row, col)
            return recursive_slicing(grid, 0, 0)
