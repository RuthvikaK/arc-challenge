     def solve(grid: List[List[int]]) -> List[List[int]]:
     def is_valid_move(x: int, y: int, dx: int, dy: int) -> bool:
     """
     Checks if a move is valid.
     """
     if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or grid[x][y]!= 0:
         return False
     return True

     def is_valid_move2(x: int, y: int, dx: int, dy: int) -> bool:
     """
     Checks if a move is valid in a grid.
     """
     for i in range(max(0, x - dx), min(len(grid), x + dx + 1)):
         for j in range(max(0, y - dy), min(len(grid[0]), y + dy + 1)):
             if grid[i][j]!= 0:
                 return False
     return True

     def is_valid_move3(x: int, y: int, dx: int, dy: int) -> bool:
     """
     Checks if a move is valid in a grid, considering the grid's size and the player's position.
     """
     for i in range(max(0, x - dx), min(len(grid), x + dx + 1)):
         for j in range(max(0, y - dy), min(len(grid[0]), y + dy + 1)):
             if grid[i][j] == 0:
                 return False
     return True

     def solve2(grid: List[List[int]], x: int, y: int, move: int) -> List[int]:
     """
     Recursively solves the puzzle.
     """
     if move == len(grid):
         return grid[x][y]
     for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
         if is_valid_move(x + dx, y + dy, dx, dy):
             grid[x][y] = move
             grid = solve2(grid, x + dx, y + dy, move + 1)
             if grid[x][y]!= move:
                 return grid[x][y]
     return None

