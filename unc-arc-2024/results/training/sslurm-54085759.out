     def solve(grid: List[List[int]]) -> List[List[int]]:
        # Define a helper function to check if the cell is within the grid
        def is_valid(x, y):
            return 0 <= x < len(grid) and 0 <= y < len(grid[0])
        # Define a helper function to check if the cell is empty
        def is_empty(x, y):
            return grid[x][y] == 0
        # Define a helper function to add the next element to the current cell
        def add_next(x, y, next_val):
            grid[x][y] = next_val
        # Define a helper function to add the next element to the current cell (if not empty)
        def add_next_empty(x, y, next_val):
            if is_empty(x, y):
                grid[x][y] = next_val
            else:
                return
        # Define a helper function to solve the puzzle
        def solve_helper(x, y, next_val):
            if not is_valid(x, y) or not is_empty(x, y):
                return
            if next_val == 1:
                add_next(x, y, 1)
            else:
                add_next_empty(x, y, 1)
            # Check if the current cell is the last element
            if next_val == 1:
                # If the next element is empty, return the current cell
                if is_empty(x, y):
                    return [grid[x][y]]
                else:
                    # If the next element is not empty, recursively call the helper function
                    return [grid[x][y]] + solve_helper(x + 1, y, 1)
            else:
                # If the next element is not empty, recursively call the helper function
                return solve_helper(x + 1, y, next_val)
        # Call the helper function to solve the puzzle
        return solve_helper(0, 0, 0)
