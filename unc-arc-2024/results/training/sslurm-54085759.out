     from typing import List

     def solve(grid: List[List[int]]) -> List[List[int]]:
        rows, cols = len(grid), len(grid[0])
        dp = [[0] * cols for _ in range(rows)]

        for i in range(rows):
            for j in range(cols):
                if grid[i][j] == 1:
                    dp[i][j] = 1

        for k in range(rows):
            for i in range(cols):
                for j in range(k+1):
                    if grid[k][i] == 1 and dp[i][j] > 0:
                        dp[k][j] = 1

        for i in range(rows):
            for j in range(cols):
                if dp[i][j] == 0:
                    dp[i][j] = 1
                    for k in range(j+1):
                        if grid[i][k] == 1 and dp[i][k] > 0:
                            dp[i][j] = 1

        for i in range(rows):
            for j in range(cols):
                if grid[i][j] == 1 and dp[i][j] == 0:
                    dp[i][j] = 1
                    for k in range(i+1):
                        if grid[k][j] == 1 and dp[k][j] > 0:
                            dp[i][j] = 1

        for i in range(rows):
            for j in range(cols):
                if dp[i][j] == 1:
                    grid[i][j] = 1

        return grid

     def print_grid(grid: List[List[int]]) -> None:
        for row in grid:
            print(row)

     def print_grid2(grid: List[List[int]], index: int, row: int) -> None:
        print(f"Grid {index} row {row}: ", end="")
        for elem in grid[row]:
            print(elem, end=" ")
        print()

     def print_grid3(grid: List[List[int]], index: int, row: int, index2: int, row2: int) -> None:
        print(f"Grid {index} row {row} index2 {index2} row2 {row2}: ", end="")
        for elem in grid[row]:
            print(elem, end=" ")
        print()

     def print_grid4(grid: List[List[int]], index: int, row: int, index2: int, row2: int, index3: int, row3: int) -> None:
        print(f"Grid {index} row {row} index2 {index2} row2 {row2} index3 {index3} row3 {row3}: ", end="")
        for elem in grid[row]:
            print(elem, end=" ")
        print()

     def print_grid5(grid: List[List[int]], index: int, row: int, index2: int, row2: int, index3: int, row3: int, index4: int, row4: int) -> None:
        print(f"Grid {index} row {row} index2 {index2} row2 {row2} index3 {index3} row3 {row3} index4 {index4} row4 {row4}: ", end="")
        for elem in grid[row]:
            print(elem, end=" ")
        print()

     def print_grid6(grid: List[List[int]], index: int, row: int, index2: int, row2: int, index3: int, row3: int, index4: int, row4: int, index5: int, row5: int) -> None:
        print(f"Grid {index} row {row} index2 {index2} row2 {row2} index3 {index3} row3 {row3} index4 {index4} row4 {row4} index5 {index5} row5 {row5}: ", end="")
        for elem in grid[row]:
            print(elem, end=" ")
        print()```



