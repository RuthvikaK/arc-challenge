     """
     def solve(grid: List[List[int]]) -> List[List[int]]:
         def dfs(i: int, j: int, visited: set) -> List[List[int]]:
             if i < 0 or i >= len(grid) or j < 0 or j >= len(grid[0]) or grid[i][j]!= 0 or visited[i][j]:
                 return []
             return [grid[i][j]] + dfs(i+1, j, visited) + dfs(i-1, j, visited) + dfs(i, j+1, visited) + dfs(i, j-1, visited)
         return dfs(0, 0, {(0, 0)})
        def grid_to_string(grid: List[List[int]]) -> str:
