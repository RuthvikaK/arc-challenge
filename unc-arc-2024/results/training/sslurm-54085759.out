     def solve_recursive(grid, x, y, visited, output):
     # Check if we've reached the target
     if x == len(grid) - 1 and y == len(grid[0]) - 1:
         output.append(grid[x][y])
         return

     # Explore all possible moves
     for dx, dy in moves:
         if is_valid_move(x, y, dx, dy):
             solve_recursive(grid, x + dx, y + dy, visited, output)

     # If we can't move, backtrack
     visited[x][y] = False

     # If we can't find a path, return None
     if not output:
         return None

     # Mark the current cell as visited
     visited[x][y] = True

     # Recursively call the function for the next cell
     solve_recursive(grid, x + dx, y + dy, visited, output)

     # If we found a path, add it to the output
     output.append(grid[x][y])

     return output

