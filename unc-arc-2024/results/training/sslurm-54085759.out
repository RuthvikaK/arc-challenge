     from typing import List, Dict

     def solve(grid: List[List[int]]) -> List[List[int]]:
         def get_neighbors(x: int, y: int, grid: List[List[int]]) -> List[List[int]]:
         """
         Returns a list of neighboring cells in the grid
         """
         neighbors = []
         for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
             nx, ny = x + dx, y + dy
             if 0 <= nx < len(grid) and 0 <= ny < len(grid[0]):
                 neighbors.append([nx, ny])
         return neighbors

         def get_value(grid: List[List[int]], x: int, y: int) -> int:
         """
         Returns the value at the given cell
         """
         return grid[x][y]

         def is_valid(x: int, y: int, grid: List[List[int]]) -> bool:
         """
         Returns whether the cell at the given coordinates is valid
         """
         return 0 <= x < len(grid) and 0 <= y < len(grid[0])

         def get_neighbors_and_value(x: int, y: int, grid: List[List[int]]) -> List[Tuple[int, int]]:
         """
         Returns a list of tuples, where each tuple contains a neighboring cell and its value
         """
         neighbors = get_neighbors(x, y, grid)
         values = [get_value(grid, nx, ny) for nx, ny in neighbors]
         return neighbors, values

         def get_value_and_neighbors(x: int, y: int, grid: List[List[int]]) -> List[Tuple[int, List[List[int]]]]:
         """
         Returns a list of tuples, where each tuple contains a value and a list of neighboring cells
         """
         neighbors, values = get_neighbors_and_value(x, y, grid)
         return [get_value(grid, nx, ny) for nx, ny in neighbors]

         def get_neighbors_and_value_and_neighbors(x: int, y: int, grid: List[List[int]]) -> List[Tuple[Tuple[int, int], List[List[int]]]]:
         """
         Returns a list of tuples, where each tuple contains a value and a list of neighboring cells and their values
         """
         neighbors, values = get_neighbors_and_value_and_neighbors(x, y, grid)
         return [get_value_and_neighbors(grid, nx, ny) for nx, ny in neighbors]

         def get_value_and_neighbors_and_neighbors(x: int, y: int, grid: List[List[int]]) -> List[Tuple[Tuple[int, int], List[List[int]]]]:
         """
         Returns a list of tuples, where each tuple contains a value and a list of neighboring cells and their values, and their neighbors
         """
         neighbors, values = get_neighbors_and_value_and_neighbors(x, y, grid)
         return [get_value_and_neighbors(x, y, grid) for x, y in neighbors]

         def get_value_and_neighbors_and_neighbors_and_neighbors(x: int, y: int, grid: List[List[int]]) -> List[Tuple[Tuple[Tuple[int, int], int], List[List[int]]]]:
         """
